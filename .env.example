HOST=127.0.0.1
PORT=3100
DATA_DIR=./data
APP_ORIGIN=http://localhost:5173
# Production: HTTPS mandatory, set SECURE_COOKIES=true and APP_ORIGIN to exact public origin.
SECURE_COOKIES=false
# Close public organization creation after onboarding if needed.
ALLOW_REGISTRATION=true
# Development only: "local" writes real one-time account links in data/mail-outbox.
# No external e-mail is sent. Always disabled in production until a provider is implemented.
MAIL_MODE=disabled
